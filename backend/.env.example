RAILS_ENV=development
FRONTEND_URL=http://localhost:3001
# Exact additional origins, comma-separated (no wildcard previews).
ADDITIONAL_FRONTEND_ORIGINS=
# Same-origin proxy: lax in development and production.
SESSION_SAME_SITE=lax
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google_oauth2/callback
DATABASE_URL=postgresql://postgres:password@localhost:5433/app_development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug
REDIS_URL=redis://localhost:6379/1
OPENAPI_SERVER_URL=http://localhost:3000
