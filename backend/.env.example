RAILS_ENV=development
FRONTEND_URL=http://localhost:3001
# Exact additional origins, comma-separated (no wildcard previews).
ADDITIONAL_FRONTEND_ORIGINS=
# Development: lax. Production default: none; set lax for same-site HTTPS domains.
SESSION_SAME_SITE=lax
DATABASE_URL=postgresql://postgres:password@localhost:5433/app_development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug
REDIS_URL=redis://localhost:6379/1
OPENAPI_SERVER_URL=http://localhost:3000
